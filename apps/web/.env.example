# Supabase (safe to expose — Row Level Security protects every row)
NEXT_PUBLIC_SUPABASE_URL=https://xqmfpuqwbwewgkjukhxf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI — for the Adea chat (server-side only, never exposed)
OPENAI_API_KEY=your-openai-key-here
# Optional: override the chat model (default: gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# Sentry error tracking — all optional; leave blank to disable Sentry entirely.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Only needed to upload source maps during a production build:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
